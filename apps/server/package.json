{
  "name": "@slave/server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:express --external:socket.io --external:nanoid --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@slave/engine": "*",
    "express": "^4.21.2",
    "nanoid": "^5.0.9",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0"
  }
}
